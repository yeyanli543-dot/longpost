# Dependencies
node_modules/
*/node_modules/

# Production builds
dist/
*/dist/
build/
*/build/

# Environment files
.env
.env.local
.env.*.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
/logs/

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/
*.lcov

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Temporary folders
tmp/
temp/
.playwright-cli/

# Lock files (keep package-lock.json for consistent installs)
yarn.lock
pnpm-lock.yaml

# Cache files
.eslintcache
*.tsbuildinfo

# swc wasm
.swc

# Agent files
.agent/
.npm_cache

# 用户上传目录（运行时产生的文件，不进仓库）
# 必须锚定到仓库根，否则会连 server/modules/uploads 一起忽略掉
/uploads/

# ---------------------------------------------------------------- 桌面版 desktop/
# 打包产物
desktop/release/
# 自检截图
desktop/.verify/

# desktop/package-lock.json —— 桌面版是独立子应用，锁文件随平台生成，不进仓库（依赖版本已在 package.json 里钉死）
desktop/package-lock.json

# 注意：resources/icon.png 和 icon-foreground.png 现在要进仓库。
# 它们是正式设计稿，不是生成物。以前 icon.png 被忽略过，后果是 CI 全新检出时没有图标，
# 自检卡在「图标」那组直接失败，Android 流水线、打包都受影响，而且报错信息跟图标毫无关系，很难查。
# make-icon.js 仍然保留，但只在图标缺失时兜底，默认不覆盖已有文件（见该脚本注释）。


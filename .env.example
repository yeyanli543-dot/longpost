# ---- 日志 ----
LOG_DIR=./logs
LOG_REQUEST_BODY=true
LOG_RESPONSE_BODY=true

# ---- JWT 签名密钥（生产环境必须设置，不要使用默认值）----
JWT_SECRET=

# ---- 数据库连接 ----
# 平台环境由平台注入；自由部署到自己的服务器时填这里。
# 也可用标准名 DATABASE_URL，两者都认。
SUDA_DATABASE_URL=
# 托管数据库（如 Supabase / RDS）通常要求 SSL，填 true 开启
POSTGRES_SSL=
# 连接池上限
DB_MAX_CONNECTIONS=10

# ---- 站长（owner）----
# 填你的邮箱。该邮箱注册 / 登录 / 用 Google 登录后会自动成为站长（admin）。
# 不填则系统会创建一个 admin@longpost.com / admin123 的默认账号——仅供本地调试，
# 线上务必配置本项，否则等于把最高权限挂在一个公开的弱口令上。
OWNER_EMAIL=

# ---- 客户端资源前缀 ----
# 平台部署保持默认（/app/<appId>）；独立部署时留空字符串
CLIENT_BASE_PATH=

# ---- 用户上传（图片 / 头像 / 附件）----
# 独立部署时必须是一个持久化目录，否则重新部署会丢文件
UPLOAD_DIR=./uploads
UPLOAD_URL_PREFIX=/uploads
# 单文件上限（字节），默认 25MB
UPLOAD_MAX_SIZE=26214400

# ---- 本地托管的第三方脚本（目前只有 echarts，公开阅读页渲染图表用）----
VENDOR_DIR=./client/public/vendor
VENDOR_URL_PREFIX=/vendor

# ---- Google OAuth（可选，留空则 Google 登录不启用）----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

{
  "name": "longpost",
  "version": "2.9.8",
  "private": true,
  "description": "Modern full-stack open-source platform for long-form content, articles and knowledge sharing",
  "scripts": {
    "dev": "concurrently -n \"server,client\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "nest start --watch",
    "dev:client": "vite --config vite.config.ts",
    "gen:db-schema": "echo 'Drizzle schema is managed in server/database/schema.ts'",
    "db:seed": "node scripts/seed.mjs",
    "build": "npm run build:server && npm run build:client",
    "build:prod": "npm run build:server && npm run build:client",
    "build:server": "nest build",
    "build:client": "vite build --config vite.config.ts",
    "start": "node dist/server/main.js",
    "lint": "node ./scripts/lint.js",
    "eslint": "eslint . --quiet",
    "stylelint": "stylelint client/src/**/*.css --quiet",
    "type:check": "concurrently -n \"server,client\" -c \"blue,green\" \"npm run type:check:server\" \"npm run type:check:client\"",
    "type:check:client": "tsc --noEmit --project tsconfig.app.json",
    "type:check:server": "tsc --noEmit --project tsconfig.node.json",
    "test": "node --import ./test/register-aliases.mjs --test test/*.test.mjs"
  },

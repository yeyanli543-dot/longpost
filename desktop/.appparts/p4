    const code = CH.encodeChartCard(card);
    const editor = $('editor');
    const pos = editor.selectionStart;
    const before = editor.value.slice(0, pos);
    const prefix = before.length && !/\n\s*$/.test(before) ? '\n\n' : '';
    insertAtCursor(prefix + code + '\n\n');
    closeChartDialog();
    toast('图表已插入正文', 'ok');
  }


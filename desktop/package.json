{
  "name": "longpost-desktop",
  "version": "3.1.2",
  "description": "LongPost 桌面版 —— 本地写作与内容工作台，全部数据保存在你自己的电脑上",
  "main": "main.js",
  "author": "yeyanli543-dot",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/yeyanli543-dot/longpost.git",
    "directory": "desktop"
  },
  "scripts": {
    "start": "electron .",
    "prepare": "node scripts/sync-vendor.js && node scripts/make-icon.js",
    "vendor": "node scripts/sync-vendor.js",
    "test": "node scripts/smoke-test.js",
    "icon": "node scripts/make-icon.js",
    "verify:ui": "electron . --smoke=./.verify/ui.png --smoke-script=scripts/ui-scenario.js --no-sandbox",
    "verify:export": "electron scripts/verify-export.js --out=./.verify/export.png --no-sandbox",
    "verify": "npm run test && npm run verify:export",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win --x64 --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "dependencies": {
    "echarts": "6.1.0",
    "flexsearch": "0.8.212",
    "hammerjs": "2.0.8",
    "html-to-image": "1.11.13",
    "katex": "0.19.0",
    "markdown-it": "15.0.2",
    "markdown-it-deflist": "4.0.0",
    "markdown-it-emoji": "3.1.0",
    "markdown-it-footnote": "4.0.0",
    "markdown-it-task-lists": "2.1.1",
    "papaparse": "5.7.0",
    "prismjs": "1.30.0",
    "pulltorefreshjs": "0.1.22",
    "swiped-events": "1.2.0"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.yeyanli543.longpost",
    "productName": "LongPost",
    "files": [
      "main.js",
      "preload.js",
      "bridge.js",
      "lib/**/*",
      "renderer/**/*",
      "package.json",
      "THIRD-PARTY-NOTICES.md",
      "!renderer/vendor/VENDOR.md",
      "!VENDOR.md",
      "!VENDOR-LICENSES.md",
      "!node_modules/**"
    ],
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LongPost"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "icon": "resources/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "icon": "resources/icon.png"
    }
  }
}

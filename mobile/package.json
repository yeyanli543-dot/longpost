{
  "name": "longpost-mobile",
  "version": "3.1.6",
  "private": true,
  "description": "LongPost 手机版外壳：前端复用现代 React 产物 dist/client，数据落在设备本地（IndexedDB/SQLite）",
  "license": "MIT",
  "scripts": {
    "web": "npm --prefix .. run build:client",
    "add:android": "cap add android",
    "sync:android": "node ../desktop/scripts/sync-vendor.js && cap sync android",
    "apk": "cd android && gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.4",
    "@capacitor/share": "8.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3"
  }
}
